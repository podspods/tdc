-- =====================================================
-- ENUM TYPES
-- =====================================================
CREATE TYPE invoice_status AS ENUM ('draft', 'pending', 'paid', 'partially_paid', 'overdue', 'cancelled');

-- =====================================================
-- TABLE: invoices
-- Description: Main invoice table
-- =====================================================
CREATE TABLE invoices (
    invoice_id SERIAL PRIMARY KEY,
    invoice_number VARCHAR(50) UNIQUE NOT NULL,
    
    -- Relations
    registration_id INTEGER NOT NULL REFERENCES registrations(registration_id) ON DELETE RESTRICT,
    owner_id INTEGER NOT NULL REFERENCES owners(owner_id) ON DELETE RESTRICT,
    
    -- Dates
    issue_date DATE NOT NULL DEFAULT CURRENT_DATE,
    due_date DATE NOT NULL,
    closed_date DATE,
    
    -- Status
    status invoice_status NOT NULL DEFAULT 'pending',
    
    -- Totals
    subtotal_labor DECIMAL(12,2) NOT NULL DEFAULT 0,
    subtotal_parts DECIMAL(12,2) NOT NULL DEFAULT 0,
    subtotal_consumables DECIMAL(12,2) NOT NULL DEFAULT 0,
    subtotal DECIMAL(12,2) GENERATED ALWAYS AS (subtotal_labor + subtotal_parts + subtotal_consumables) STORED,
    
    tax_rate DECIMAL(5,2) DEFAULT 10.0,
    tax_amount DECIMAL(12,2) GENERATED ALWAYS AS (subtotal * tax_rate / 100) STORED,
    total_amount DECIMAL(12,2) GENERATED ALWAYS AS (subtotal + (subtotal * tax_rate / 100)) STORED,
    
    -- Payment tracking
    amount_paid DECIMAL(12,2) NOT NULL DEFAULT 0,
    amount_due DECIMAL(12,2) GENERATED ALWAYS AS (total_amount - amount_paid) STORED,
    
    -- Payment method
    payment_method VARCHAR(50), -- 'cash', 'card', 'bank_transfer', 'e_wallet'
    payment_reference VARCHAR(100),
    payment_date DATE,
    
    -- Notes
    notes TEXT,
    internal_notes TEXT,
    
    -- Metadata
    created_by VARCHAR(100) NOT NULL,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- =====================================================
-- TABLE: invoice_labor_items
-- Description: Labor items for invoices
-- =====================================================
CREATE TABLE invoice_labor_items (
    labor_item_id SERIAL PRIMARY KEY,
    invoice_id INTEGER NOT NULL REFERENCES invoices(invoice_id) ON DELETE CASCADE,
    
    description VARCHAR(255) NOT NULL,
    hours DECIMAL(10,2) NOT NULL,
    rate_per_hour DECIMAL(12,2) NOT NULL,
    amount DECIMAL(12,2) GENERATED ALWAYS AS (hours * rate_per_hour) STORED,
    
    mechanic_name VARCHAR(100),
    notes TEXT,
    
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- =====================================================
-- TABLE: invoice_parts_items
-- Description: Parts items for invoices
-- =====================================================
CREATE TABLE invoice_parts_items (
    parts_item_id SERIAL PRIMARY KEY,
    invoice_id INTEGER NOT NULL REFERENCES invoices(invoice_id) ON DELETE CASCADE,
    
    part_name VARCHAR(255) NOT NULL,
    part_reference VARCHAR(100),
    quantity INTEGER NOT NULL DEFAULT 1,
    unit_price DECIMAL(12,2) NOT NULL,
    amount DECIMAL(12,2) GENERATED ALWAYS AS (quantity * unit_price) STORED,
    
    supplier VARCHAR(100),
    warranty_months INTEGER,
    notes TEXT,
    
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- =====================================================
-- TABLE: invoice_consumable_items
-- Description: Consumable items for invoices
-- =====================================================
CREATE TABLE invoice_consumable_items (
    consumable_item_id SERIAL PRIMARY KEY,
    invoice_id INTEGER NOT NULL REFERENCES invoices(invoice_id) ON DELETE CASCADE,
    
    consumable_name VARCHAR(255) NOT NULL,
    quantity DECIMAL(10,2) NOT NULL DEFAULT 1,
    unit VARCHAR(20), -- 'liter', 'kg', 'piece', etc.
    unit_price DECIMAL(12,2) NOT NULL,
    amount DECIMAL(12,2) GENERATED ALWAYS AS (quantity * unit_price) STORED,
    
    notes TEXT,
    
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- =====================================================
-- TABLE: invoice_payments
-- Description: Track partial payments
-- =====================================================
CREATE TABLE invoice_payments (
    payment_id SERIAL PRIMARY KEY,
    invoice_id INTEGER NOT NULL REFERENCES invoices(invoice_id) ON DELETE CASCADE,
    
    payment_date DATE NOT NULL DEFAULT CURRENT_DATE,
    amount DECIMAL(12,2) NOT NULL,
    payment_method VARCHAR(50) NOT NULL, -- 'cash', 'card', 'bank_transfer', 'e_wallet'
    reference VARCHAR(100),
    notes TEXT,
    
    created_by VARCHAR(100) NOT NULL,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- =====================================================
-- INDEXES
-- =====================================================
CREATE INDEX idx_invoices_number ON invoices(invoice_number);
CREATE INDEX idx_invoices_registration ON invoices(registration_id);
CREATE INDEX idx_invoices_owner ON invoices(owner_id);
CREATE INDEX idx_invoices_status ON invoices(status);
CREATE INDEX idx_invoices_due_date ON invoices(due_date);
CREATE INDEX idx_invoices_issue_date ON invoices(issue_date);

CREATE INDEX idx_labor_invoice ON invoice_labor_items(invoice_id);
CREATE INDEX idx_parts_invoice ON invoice_parts_items(invoice_id);
CREATE INDEX idx_consumables_invoice ON invoice_consumable_items(invoice_id);
CREATE INDEX idx_payments_invoice ON invoice_payments(invoice_id);

-- =====================================================
-- TRIGGER for updated_at
-- =====================================================
CREATE TRIGGER trigger_invoices_updated_at
    BEFORE UPDATE ON invoices
    FOR EACH ROW
    EXECUTE FUNCTION update_updated_at_column();

-- =====================================================
-- FUNCTION: Update invoice totals when items change
-- =====================================================
CREATE OR REPLACE FUNCTION update_invoice_totals()
RETURNS TRIGGER AS $$
DECLARE
    v_invoice_id INTEGER;
    v_labor_total DECIMAL(12,2);
    v_parts_total DECIMAL(12,2);
    v_consumables_total DECIMAL(12,2);
BEGIN
    -- Determine which invoice to update
    IF TG_OP = 'DELETE' THEN
        v_invoice_id = OLD.invoice_id;
    ELSE
        v_invoice_id = NEW.invoice_id;
    END IF;
    
    -- Calculate totals
    SELECT COALESCE(SUM(amount), 0) INTO v_labor_total
    FROM invoice_labor_items WHERE invoice_id = v_invoice_id;
    
    SELECT COALESCE(SUM(amount), 0) INTO v_parts_total
    FROM invoice_parts_items WHERE invoice_id = v_invoice_id;
    
    SELECT COALESCE(SUM(amount), 0) INTO v_consumables_total
    FROM invoice_consumable_items WHERE invoice_id = v_invoice_id;
    
    -- Update invoice
    UPDATE invoices SET
        subtotal_labor = v_labor_total,
        subtotal_parts = v_parts_total,
        subtotal_consumables = v_consumables_total,
        updated_at = CURRENT_TIMESTAMP
    WHERE invoice_id = v_invoice_id;
    
    RETURN NULL;
END;
$$ LANGUAGE plpgsql;

-- Triggers for each item table
CREATE TRIGGER trigger_update_labor_totals
    AFTER INSERT OR UPDATE OR DELETE ON invoice_labor_items
    FOR EACH ROW
    EXECUTE FUNCTION update_invoice_totals();

CREATE TRIGGER trigger_update_parts_totals
    AFTER INSERT OR UPDATE OR DELETE ON invoice_parts_items
    FOR EACH ROW
    EXECUTE FUNCTION update_invoice_totals();

CREATE TRIGGER trigger_update_consumables_totals
    AFTER INSERT OR UPDATE OR DELETE ON invoice_consumable_items
    FOR EACH ROW
    EXECUTE FUNCTION update_invoice_totals();

-- =====================================================
-- FUNCTION: Generate invoice number
-- =====================================================
CREATE OR REPLACE FUNCTION generate_invoice_number()
RETURNS TRIGGER AS $$
DECLARE
    year_prefix VARCHAR(4);
    sequence_num INTEGER;
    new_number VARCHAR(50);
BEGIN
    year_prefix := TO_CHAR(NEW.issue_date, 'YYYY');
    
    SELECT COALESCE(MAX(CAST(SUBSTRING(invoice_number FROM 9) AS INTEGER)), 0) + 1
    INTO sequence_num
    FROM invoices
    WHERE invoice_number LIKE 'INV-' || year_prefix || '-%';
    
    NEW.invoice_number := 'INV-' || year_prefix || '-' || LPAD(sequence_num::TEXT, 5, '0');
    
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER trigger_generate_invoice_number
    BEFORE INSERT ON invoices
    FOR EACH ROW
    EXECUTE FUNCTION generate_invoice_number();

