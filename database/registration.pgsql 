-- =====================================================
-- TABLE: registrations (simplified version)
-- Description: Motorcycle registrations with plate number as unique key
-- =====================================================

CREATE TABLE registrations (
    registration_id SERIAL PRIMARY KEY,
    plate_number VARCHAR(20) UNIQUE NOT NULL,
    owner_name VARCHAR(200) NOT NULL,
    owner_phone VARCHAR(20),
    owner_email VARCHAR(255),
    color VARCHAR(50),
    
    -- Relations
    brand_id INTEGER NOT NULL REFERENCES motorcycle_brands(brand_id),
    model_id INTEGER REFERENCES motorcycle_models(model_id),
    
    -- Metadata
    created_by VARCHAR(100) NOT NULL,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    
    -- Constraints
    CONSTRAINT valid_email CHECK (owner_email IS NULL OR owner_email ~* '^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$'),
    CONSTRAINT valid_phone CHECK (owner_phone IS NULL OR owner_phone ~ '^[0-9+\-\s]{10,15}$')
);

-- Indexes
CREATE INDEX idx_registrations_plate ON registrations(plate_number);
CREATE INDEX idx_registrations_owner ON registrations(owner_name);
CREATE INDEX idx_registrations_brand ON registrations(brand_id);
CREATE INDEX idx_registrations_model ON registrations(model_id);

-- Trigger for updated_at
CREATE TRIGGER trigger_registrations_updated_at
    BEFORE UPDATE ON registrations
    FOR EACH ROW
    EXECUTE FUNCTION update_updated_at_column();

