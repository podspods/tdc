import { useTranslation } from "react-i18next";
import { Button, MainContainer, Table, Tbody, Td, Th, Thead, Tr } from "../../common/common.styled";
import type { InvoiceInfo } from "./invoice.types";

export type PageContentProps = {
  loading: boolean;
  generatingId: number;
  invoiceInfoList: InvoiceInfo[];
  handleGeneratePdf: (id: number) => void;
  handleEdit: (id: number) => void;
};
export default function PageContent({ ...props }: PageContentProps) {
  const { t } = useTranslation(["invoice"]);

  //--------------------------------------------------------------------------------------------------------------------------

  return (
    <>
      {/* List of existing props.invoiceList */}
      {/* <div style={{ marginTop: "2rem" }}> */}
      <MainContainer>
        <h2>{t("existingInvoices")}</h2>
        {props.loading ? (
          <p>Loading invoiceList...</p>
        ) : props.invoiceInfoList.length === 0 ? (
          <p>No props.invoiceList found.</p>
        ) : (
          <Table>
            <Thead>
              <Tr>
                <Th>{t("id")}</Th>
                <Th>{t("invoice")}</Th>
                <Th>{t("owner")}</Th>
                <Th>{t("vehicle")}</Th>
                <Th>{t("dueDate")}</Th>
                <Th>{t("issueDate")}</Th>
                <Th>{t("status")}</Th>
                <Th></Th>
              </Tr>
            </Thead>
            <Tbody>
              {props.invoiceInfoList.map((invoice) => (
                <Tr key={invoice.id}>
                  <Td>[{invoice.id}]</Td>
                  <Td>{invoice.invoiceNumber}</Td>
                  <Td>
                    {invoice.ownerFirstName} {invoice.ownerLastName}
                  </Td>
                  <Td>
                    {invoice.vehicleBrand} {invoice.vehicleModel} {invoice.vehicleColor}{" "}
                    {invoice.vehicleplateNumber}
                  </Td>
                  <Td>{new Date(invoice.dueDate).toLocaleDateString("vi-VN")}</Td>

                  <Td>{new Date(invoice.issueDate).toLocaleDateString("vi-VN")}</Td>
                  <Td>{invoice.statusText}</Td>
                  <Td style={{ display: "flex" }}>
                    <Button
                      variant="secondary"
                      onClick={() => props.handleGeneratePdf(invoice.id)}
                      disabled={props.generatingId === invoice.id}
                    >
                      {props.generatingId === invoice.id ? t("generating...") : t("generatePDF")}
                    </Button>
                    <Button variant="primary" onClick={() => props.handleEdit(invoice.id)}>
                      🖍
                    </Button>
                  </Td>
                </Tr>
              ))}
            </Tbody>
          </Table>
        )}
        {/* </div> */}
      </MainContainer>
    </>
  );
}
