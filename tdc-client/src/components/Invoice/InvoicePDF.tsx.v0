// src/components/Invoice/InvoicePDF.tsx
import { Document, Page, Text, View, StyleSheet, Image, Font } from "@react-pdf/renderer";
import type { GarageInfo } from "./invoice.types";
import type { CreateOwnerDto } from "../owner/owner.types";
import type { Vehicle } from "../vehicle/vehicle.types";

import regularFont from "../../assets/fonts/BeVietnamPro-Regular.ttf";
import italicFont from "../../assets/fonts/BeVietnamPro-Italic.ttf";

Font.register({
  family: "Be Vietnam Pro",
  fonts: [
    { src: regularFont, fontWeight: 400, fontStyle: "normal" },
    { src: italicFont, fontWeight: 400, fontStyle: "italic" },
  ],
});
// Types pour les items
type LaborItem = {
  id: string;
  description: string;
  hours: number;
  ratePerHour: number;
  amount: number;
};

type PartItem = {
  id: string;
  name: string;
  quantity: number;
  unitPrice: number;
  amount: number;
};

type ConsumableItem = {
  id: string;
  name: string;
  quantity: number;
  unitPrice: number;
  amount: number;
};

type InvoicePDFProps = {
  garage: GarageInfo; // logoUrl, name, address, phone, etc.
  owner: CreateOwnerDto; // firstName, lastName, phoneNumber, address, city
  vehicle?: Vehicle; // plateNumber, brand, model, year, color, mileage
  laborItems?: LaborItem[];
  partItems?: PartItem[];
  consumableItems?: ConsumableItem[];
  subtotalLabor: number | 0;
  subtotalParts: number | 0;
  subtotalConsumables: number | 0;
  subtotal: number | 0;
  taxRate: number | 0;
  taxAmount: number | 0;
  totalAmount: number | 0;
  notes: string | "";
  date: string | ""; // Date d'émission (format DD/MM/YYYY | 0)
};

const styles = StyleSheet.create({
  page: {
    padding: 30,
    fontFamily: "Be Vietnam Pro",
    fontSize: 10,
  },
  // En-tête
  headerContainer: {
    flexDirection: "row",
    justifyContent: "space-between",
    marginBottom: 20,
  },
  leftColumn: {
    flex: 1,
  },
  rightColumn: {
    flex: 1,
    alignItems: "flex-end",
  },
  logo: {
    width: 80,
    marginBottom: 8,
  },
  garageName: {
    fontSize: 16,
    fontWeight: "bold",
    marginBottom: 4,
  },
  garageDetails: {
    fontSize: 9,
    color: "#4b5563",
    marginTop: 2,
  },
  ownerName: {
    fontSize: 12,
    fontWeight: "bold",
    marginBottom: 4,
  },
  ownerDetails: {
    fontSize: 9,
    color: "#374151",
    marginTop: 2,
  },
  // Date
  dateSection: {
    alignItems: "center",
    marginBottom: 20,
    borderTopWidth: 1,
    borderBottomWidth: 1,
    borderColor: "#e5e7eb",
    paddingVertical: 8,
  },
  dateText: {
    fontSize: 10,
    fontWeight: "bold",
  },
  // Sections communes
  sectionTitle: {
    fontSize: 14,
    fontWeight: "bold",
    marginTop: 16,
    marginBottom: 8,
    backgroundColor: "#f3f4f6",
    padding: 6,
  },
  table: {
    width: "100%",
    marginBottom: 12,
  },
  tableHeader: {
    flexDirection: "row",
    borderBottomWidth: 1,
    borderBottomColor: "#d1d5db",
    paddingBottom: 4,
    marginBottom: 4,
    fontWeight: "bold",
  },
  tableRow: {
    flexDirection: "row",
    marginBottom: 4,
  },
  colDesc: { width: "40%" },
  colQty: { width: "15%", textAlign: "center" },
  colUnitPrice: { width: "20%", textAlign: "right" },
  colAmount: { width: "25%", textAlign: "right" },
  // Résumé
  summaryContainer: {
    marginTop: 16,
    borderTopWidth: 1,
    borderTopColor: "#e5e7eb",
    paddingTop: 12,
    alignItems: "flex-end",
  },
  summaryRow: {
    flexDirection: "row",
    marginBottom: 4,
    width: "50%",
    justifyContent: "space-between",
  },
  summaryLabel: { fontWeight: "bold" },
  totalRow: {
    flexDirection: "row",
    marginTop: 8,
    paddingTop: 8,
    borderTopWidth: 1,
    borderTopColor: "#e5e7eb",
    width: "50%",
    justifyContent: "space-between",
    fontWeight: "bold",
    fontSize: 12,
  },
  // Accords
  signatures: {
    flexDirection: "row",
    justifyContent: "space-between",
    marginTop: 40,
    paddingTop: 20,
  },
  signatureBox: {
    flex: 1,
    alignItems: "center",
  },
  signatureLine: {
    borderTopWidth: 1,
    borderTopColor: "#000",
    width: "80%",
    marginTop: 20,
    marginBottom: 4,
  },
  signatureText: {
    fontSize: 9,
    fontStyle: "italic",
  },
});

const formatCurrency = (amount: number) => {
  return amount.toLocaleString("vi-VN") + " ₫";
};

export default function InvoicePDF({
  garage,
  owner,
  vehicle,
  laborItems,
  partItems,
  consumableItems,
  subtotalLabor,
  subtotalParts,
  subtotalConsumables,
  subtotal,
  taxRate,
  taxAmount,
  totalAmount,
  notes,
  date,
}: InvoicePDFProps) {
  return (
    <Document>
      <Page size="A4" style={styles.page}>
        {/* En-tête : Garage à gauche, Owner + Véhicule à droite */}
        <View style={styles.headerContainer}>
          <View style={styles.leftColumn}>
            {garage.logoUrl && <Image src={garage.logoUrl} style={styles.logo} />}
            <Text style={styles.garageName}>{garage.name}</Text>
            <Text style={styles.garageDetails}>{garage.address}</Text>
            <Text style={styles.garageDetails}>Điện thoại: {garage.phone}</Text>
            {garage.email && <Text style={styles.garageDetails}>Email: {garage.email}</Text>}
            {garage.taxCode && <Text style={styles.garageDetails}>MST: {garage.taxCode}</Text>}
          </View>
          <View style={styles.rightColumn}>
            <Text style={styles.ownerName}>Thông tin khách hàng</Text>
            <Text style={styles.ownerDetails}>
              {owner.firstName} {owner.lastName}
            </Text>
            <Text style={styles.ownerDetails}>Điện thoại: {owner.phoneNumber}</Text>
            {owner.email && <Text style={styles.ownerDetails}>Email: {owner.email}</Text>}
            {owner.address && (
              <Text style={styles.ownerDetails}>
                Địa chỉ: {owner.address}, {owner.city}
              </Text>
            )}

            <Text style={[styles.ownerName, { marginTop: 12 }]}>Thông tin xe</Text>
            <Text style={styles.ownerDetails}>Biển số: {vehicle?.plateNumber}</Text>
            <Text style={styles.ownerDetails}>Xe: {vehicle?.plateNumber}</Text>
            <Text style={styles.ownerDetails}>Màu: {vehicle?.color}</Text>
            <Text style={styles.ownerDetails}>Số km: {vehicle?.mileage?.toLocaleString()} km</Text>
          </View>
        </View>

        {/* Date du jour */}
        <View style={styles.dateSection}>
          <Text style={styles.dateText}>Ngày lập: {date}</Text>
        </View>

        {/* Liste des tâches (main d'œuvre) */}
        <Text style={styles.sectionTitle}>Dịch vụ thực hiện</Text>
        <View style={styles.table}>
          <View style={styles.tableHeader}>
            <Text style={styles.colDesc}>Mô tả</Text>
            <Text style={styles.colQty}>Giờ</Text>
            <Text style={styles.colUnitPrice}>Đơn giá</Text>
            <Text style={styles.colAmount}>Thành tiền</Text>
          </View>
          {laborItems?.map((item) => (
            <View key={item.id} style={styles.tableRow}>
              <Text style={styles.colDesc}>{item.description}</Text>
              <Text style={styles.colQty}>{item.hours}</Text>
              <Text style={styles.colUnitPrice}>{formatCurrency(item.ratePerHour)}</Text>
              <Text style={styles.colAmount}>{formatCurrency(item.amount)}</Text>
            </View>
          ))}
        </View>

        {/* Liste des pièces détachées */}
        <Text style={styles.sectionTitle}>Phụ tùng thay thế</Text>
        <View style={styles.table}>
          <View style={styles.tableHeader}>
            <Text style={styles.colDesc}>Tên phụ tùng</Text>
            <Text style={styles.colQty}>Số lượng</Text>
            <Text style={styles.colUnitPrice}>Đơn giá</Text>
            <Text style={styles.colAmount}>Thành tiền</Text>
          </View>
          {partItems?.map((item) => (
            <View key={item.id} style={styles.tableRow}>
              <Text style={styles.colDesc}>{item.name}</Text>
              <Text style={styles.colQty}>{item.quantity}</Text>
              <Text style={styles.colUnitPrice}>{formatCurrency(item.unitPrice)}</Text>
              <Text style={styles.colAmount}>{formatCurrency(item.amount)}</Text>
            </View>
          ))}
        </View>

        {/* Liste des consommables */}
        <Text style={styles.sectionTitle}>Vật tư tiêu hao</Text>
        <View style={styles.table}>
          <View style={styles.tableHeader}>
            <Text style={styles.colDesc}>Tên vật tư</Text>
            <Text style={styles.colQty}>Số lượng</Text>
            <Text style={styles.colUnitPrice}>Đơn giá</Text>
            <Text style={styles.colAmount}>Thành tiền</Text>
          </View>
          {consumableItems?.map((item) => (
            <View key={item.id} style={styles.tableRow}>
              <Text style={styles.colDesc}>{item.name}</Text>
              <Text style={styles.colQty}>{item.quantity}</Text>
              <Text style={styles.colUnitPrice}>{formatCurrency(item.unitPrice)}</Text>
              <Text style={styles.colAmount}>{formatCurrency(item.amount)}</Text>
            </View>
          ))}
        </View>

        {/* Résumé financier */}
        <View style={styles.summaryContainer}>
          <View style={styles.summaryRow}>
            <Text style={styles.summaryLabel}>Tổng tiền dịch vụ:</Text>
            <Text>{formatCurrency(subtotalLabor)}</Text>
          </View>
          <View style={styles.summaryRow}>
            <Text style={styles.summaryLabel}>Tổng tiền phụ tùng:</Text>
            <Text>{formatCurrency(subtotalParts)}</Text>
          </View>
          <View style={styles.summaryRow}>
            <Text style={styles.summaryLabel}>Tổng tiền vật tư:</Text>
            <Text>{formatCurrency(subtotalConsumables)}</Text>
          </View>
          <View style={styles.summaryRow}>
            <Text style={styles.summaryLabel}>Tổng cộng (chưa thuế):</Text>
            <Text>{formatCurrency(subtotal)}</Text>
          </View>
          <View style={styles.summaryRow}>
            <Text style={styles.summaryLabel}>Thuế GTGT ({taxRate}%):</Text>
            <Text>{formatCurrency(taxAmount)}</Text>
          </View>
          <View style={styles.totalRow}>
            <Text>Tổng thanh toán:</Text>
            <Text>{formatCurrency(totalAmount)}</Text>
          </View>
          {notes && (
            <View style={{ marginTop: 8, width: "50%", alignSelf: "flex-end" }}>
              <Text style={{ fontSize: 9, fontStyle: "italic" }}>Ghi chú: {notes}</Text>
            </View>
          )}
        </View>

        {/* Accords */}
        <View style={styles.signatures}>
          <View style={styles.signatureBox}>
            <Text>ĐẠI DIỆN GARAGE</Text>
            <View style={styles.signatureLine} />
            <Text style={styles.signatureText}>(Ký, ghi rõ họ tên)</Text>
          </View>
          <View style={styles.signatureBox}>
            <Text>KHÁCH HÀNG</Text>
            <View style={styles.signatureLine} />
            <Text style={styles.signatureText}>(Ký, ghi rõ họ tên)</Text>
          </View>
        </View>
      </Page>
    </Document>
  );
}
