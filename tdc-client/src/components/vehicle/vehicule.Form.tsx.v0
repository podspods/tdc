import { useEffect, useState } from "react";
import type { CreateVehicleDto, Vehicle } from "./types";
import { VEHICLE_DTO_INIT, vehicleInit } from "../../common/constant";
import { Button, FormGrid } from "../../common/common.styled";
import FormGroup from "../UI.v0/FormGroup";
import { useTranslation } from "react-i18next";

export type FormProps = {
  vehicle: Vehicle;
  onCancel: () => void;
  isLoading?: boolean;
};
export default function Form({ ...props }: FormProps) {
  const { t } = useTranslation(["vehicle"]);

  const [vehicle, setVehicle] = useState<Vehicle>(vehicleInit);

  useEffect(() => {
    setVehicle(props.vehicle);
  }, [props.vehicle]);

  function handleChange(
    e: React.ChangeEvent<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>,
  ) {
    console.log("handleChange =>", e.target);
    console.log("handleChange name=>", e.target.name);
    console.log("handleChange value=>", e.target.value);
    const { name, value } = e.target;
    setVehicle((prev) => ({ ...prev, [name]: value }));
    console.log("formData", formData);
  }
  //--------------------------------------------------------------------------------------------------------------------------

  const handleSave = () => {};
  //--------------------------------------------------------------------------------------------------------------------------
  const handlePlateNumberChange = () => {};
  //--------------------------------------------------------------------------------------------------------------------------

  return (
    <>
      <form>
        <FormGrid>
          <FormGroup
            label={t("plateNumber")} // check if exist  ???????????????????
            name="plateNumber"
            value={vehicle.plateNumber || ""}
            onChange={handlePlateNumberChange}
          />

          <FormGroup
            label={t("modelId")}
            name="modelId"
            value={vehicle.modelId?.toString() || ""}
            onChange={handleChange}
          />
          <FormGroup
            label={t("vintage")}
